# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The publishable (anon) key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the app, used in sign-in links. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
